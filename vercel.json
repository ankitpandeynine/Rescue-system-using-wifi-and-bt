{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/remote(.*)",
      "destination": "/api"
    },
    {
      "source": "/apk",
      "destination": "/api"
    },
    {
      "source": "/((?!api|remote|apk).*)",
      "destination": "/index.html"
    }
  ]
}
